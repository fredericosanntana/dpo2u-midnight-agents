{
  "name": "dpo2u-midnight-agents",
  "version": "0.3.0",
  "type": "module",
  "description": "Self-funding autonomous agents on Midnight Network — dual-token model with $NIGHT/$DUST",
  "scripts": {
    "demo:dust": "tsx demos/01-dust-generation/run.ts",
    "demo:deflation": "tsx demos/02-deflation-model/run.ts",
    "deploy:preprod": "tsx scripts/deploy-preprod.ts --network preprod",
    "deploy:preview": "tsx scripts/deploy-preprod.ts --network preview",
    "deploy:standalone": "tsx scripts/deploy-preprod.ts --network standalone",
    "deploy:preprod:faucet": "tsx scripts/deploy-preprod.ts --network preprod --faucet",
    "deploy:preprod:demo": "tsx scripts/deploy-preprod.ts --network preprod --register-demo",
    "join:preprod": "tsx scripts/deploy-preprod.ts --network preprod --join"
  },
  "devDependencies": {
