{
  "name": "dpo2u-midnight-agents",
  "version": "0.4.0",
  "type": "module",
  "description": "Self-funding autonomous agents on Midnight Network — dual-token model with $NIGHT/$DUST",
  "scripts": {
    "deploy:preprod": "tsx scripts/deploy-preprod.ts --network preprod",
    "deploy:preprod:all": "tsx scripts/deploy-preprod.ts --network preprod --all",
    "deploy:standalone": "tsx scripts/deploy-preprod.ts --network standalone",
    "start-proof-server": "docker run -d --name midnight-proof-server -p 6300:6300 midnightntwrk/proof-server:8.0.3 -- midnight-proof-server -v"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "tsx": "^4.21.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "ws": "^8.19.0",
    "rxjs": "^7.8.2",
    "pino": "^9.0.0",
    "level": "^8.0.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/compact-js": "2.5.1",
    "@midnight-ntwrk/ledger-v8": "8.1.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.0",
    "@midnight-ntwrk/midnight-js-types": "4.1.0",
    "@midnight-ntwrk/midnight-js-utils": "4.1.0",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.0",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.0",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.0",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.0",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.0",
    "@midnight-ntwrk/wallet-sdk": "1.1.0"
  },
  "overrides": {
    "@midnight-ntwrk/ledger-v8": "8.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fredericosanntana/dpo2u-midnight-agents.git"
  }
}
